## 백엔드 개발 환경 예시
## 실제 값으로 변경 후 파일명을 ".env.development" 로 저장하세요.
##
## 참고: DATABASE_URL은 반드시 postgresql URL 형식이며, port는 숫자여야 합니다.
## 예) postgresql://user:password@localhost:5432/meetingroom_db?schema=public

DATABASE_URL="postgresql://user:password@localhost:5432/meetingroom_db?schema=public"
PORT=3001
FRONTEND_BASE_URL="http://localhost:3000"

# SSO 설정
SSO_SITE_NAME="37AF0BE78AC74093A77E320F4CA451C4"

# 개발 모드 자동 로그인 (선택)
DEV_USER_EMPLOYEE_ID=""

