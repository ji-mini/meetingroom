## 백엔드 개발 환경 예시
## 로컬에서 직접 실행할 땐 ".env.development"로 저장해서 사용하세요.
## EC2에서 docker-compose로 실행할 땐 backend.dev.env로 만들어 env_file로 주입하는 방식을 권장합니다.
##
## 참고: DATABASE_URL은 반드시 postgresql URL 형식이며, port는 숫자여야 합니다.
## 예) postgresql://user:password@localhost:5432/meetingroom_db?schema=public

# 개발 모드
NODE_ENV=development

PORT=3001

# DB (RDS 권장)
# - password에 특수문자가 있으면 URL 인코딩이 필요할 수 있습니다.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/meetingroom_db?schema=public

# 프론트 기준 베이스 URL (배포/Nginx 구성에 따라 다르면 비워도 됩니다)
FRONTEND_BASE_URL=http://localhost

# SSO
SSO_API_URL=http://sso.eland.com/nsso-authweb/elandWebServices/elandUserAuth
SSO_SITE_NAME=

# 개발용 유저 우회 (비우면 첫 번째 ADMIN 계정으로 자동 로그인, ADMIN이 없으면 첫 번째 사용자로)
DEV_USER_EMPLOYEE_ID=

