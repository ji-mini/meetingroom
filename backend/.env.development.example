## 백엔드 개발 환경 예시
## 실제 값으로 변경 후 파일명을 ".env.development" 로 저장하세요.
##
## 참고: DATABASE_URL은 반드시 postgresql URL 형식이며, port는 숫자여야 합니다.
## 예) postgresql://user:password@localhost:5432/meetingroom_db?schema=public

# 개발 모드
NODE_ENV=development

# 로컬(dev): docker db를 쓸 경우 예시
# DATABASE_URL="postgresql://meetingroom:meetingroom@db:5432/meetingroom_db?schema=public"

# EC2(dev): RDS를 쓸 경우 예시 (값은 EC2 환경변수/비밀관리로 주입 권장)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/meetingroom_db?schema=public"

PORT=3001
FRONTEND_BASE_URL="http://localhost:3000"

SSO_API_URL="http://sso.eland.com/nsso-authweb/elandWebServices/elandUserAuth"
SSO_SITE_NAME=""    # EPMS

DEV_USER_EMPLOYEE_ID="E98764"   # 설정하지 않으면 첫 번째 ADMIN 계정으로 자동 로그인, ADMIN이 없으면 첫 번째 사용자로

