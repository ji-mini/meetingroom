## 백엔드 운영 환경 예시
## 실제 값으로 변경 후 파일명을 ".env.production" 로 저장하세요.
##
## 주의: 이 파일(.env.production)은 비밀정보(DB 비번 등)가 포함될 수 있으니 커밋하지 마세요.

NODE_ENV=production
PORT=3001
FRONTEND_BASE_URL="http://localhost:3000"

# 운영 DB 연결 (예시)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROD-DB-ENDPOINT:5432/meetingroom_db?schema=public"

# SSO
SSO_SITE_NAME="37AF0BE78AC74093A77E320F4CA451C4"

