## EC2 dev 환경 변수 예시
## 실제 값으로 변경 후 파일명을 ".env.ec2-dev" 로 저장하세요.
##
## 주의: 이 파일(.env.ec2-dev)은 비밀정보(DB 비번 등)가 포함될 수 있으니 커밋하지 마세요.

# Backend
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/meetingroom_db?schema=public"
FRONTEND_BASE_URL="http://<EC2_PUBLIC_IP_OR_DOMAIN>:3000"
SSO_SITE_NAME=""
DEV_USER_EMPLOYEE_ID=""

# Frontend (Vite)
# 비워두면 프론트는 /api 프록시를 사용합니다.
VITE_API_BASE_URL=""
# Docker 네트워크에서 백엔드로 프록시 (기본값을 그대로 쓰면 됨)
VITE_PROXY_TARGET="http://backend:3001"

